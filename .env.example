# Public Supabase project URL and publishable key.
# These are safe to expose in the browser. Never put the service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional. When set on the server (Vercel), photo upload uses Gemini to suggest
# category, colour, brand, and distinctive features. Without it, the app still
# reads the photo's main colour on the device.
GEMINI_API_KEY=your-gemini-api-key
